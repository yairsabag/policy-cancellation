{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yairsabag.github.io/policy-cancellation/schema/policy.cancellation.schema.json",
  "title": "io.github.yairsabag.policy.cancellation",
  "description": "Independent third-party cancellation policy type for the policies[] primitive shipped in UCP v2026-08-25. Validates the UCP policy envelope plus the v0.3 cancellation fields.",
  "allOf": [
    {
      "$ref": "#/$defs/ucp_policy_v2026_08_25"
    },
    {
      "$ref": "#/$defs/cancellation_body"
    }
  ],
  "$defs": {
    "ucp_policy_v2026_08_25": {
      "title": "UCP Policy base contract (v2026-08-25)",
      "description": "Self-contained copy of the policies[] item fields needed for offline validation. Source: UCP v2026-08-25 shopping/types/policy.json.",
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9_])?)+$"
        },
        "description": {
          "$ref": "#/$defs/ucp_description"
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "ucp_description": {
      "title": "UCP Description",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "properties": {
        "plain": {
          "type": "string"
        },
        "html": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        }
      }
    },
    "cancellation_body": {
      "title": "Cancellation policy body",
      "type": "object",
      "required": [
        "type",
        "anchor",
        "rules"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "io.github.yairsabag.policy.cancellation"
        },
        "anchor": {
          "type": "string",
          "format": "date-time",
          "description": "The reference moment (check-in, event start, service time). Anchor-relative deadlines count backwards from this moment."
        },
        "rules": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "description": "Outcomes keyed by trigger. Known triggers are buyer_cancel, no_show, seller_cancel and seller_postpone. Readers MUST tolerate unknown triggers.",
          "properties": {
            "buyer_cancel": {
              "type": "object",
              "required": [
                "tiers"
              ],
              "additionalProperties": true,
              "properties": {
                "tiers": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "description": "Ordered by the time at which each tier stops applying. Semantic ordering and entitlement monotonicity are checked by the reference validator.",
                  "items": {
                    "$ref": "#/$defs/tier"
                  }
                },
                "after_last_tier": {
                  "$ref": "#/$defs/outcome",
                  "description": "Outcome once the last deadline passes. Default: percentage with buyer_bps 0."
                }
              }
            },
            "no_show": {
              "$ref": "#/$defs/outcome"
            },
            "seller_cancel": {
              "$ref": "#/$defs/outcome"
            },
            "seller_postpone": {
              "$ref": "#/$defs/outcome"
            }
          }
        },
        "payout": {
          "type": "object",
          "required": [
            "method"
          ],
          "additionalProperties": true,
          "description": "Optional. How buyer value is delivered. Absent means original payment rails at 1.0x. Readers MUST tolerate unknown methods.",
          "properties": {
            "method": {
              "type": "string",
              "examples": [
                "original",
                "credit"
              ],
              "description": "Well-known values are original and credit. Unknown values MUST be tolerated."
            },
            "multiplier_bps": {
              "type": "integer",
              "minimum": 0,
              "description": "Value multiplier in basis points (12000 = credit worth 120% of the refund amount). Default 10000."
            }
          }
        }
      }
    },
    "tier": {
      "type": "object",
      "required": [
        "until",
        "outcome"
      ],
      "additionalProperties": true,
      "properties": {
        "until": {
          "type": "string",
          "pattern": "^P(?!$)(\\d+D)?(T(\\d+H)?(\\d+M)?(\\d+S)?)?$",
          "description": "ISO 8601 duration using days and time units. Business-day counting is not supported."
        },
        "relative_to": {
          "type": "string",
          "examples": [
            "anchor",
            "purchase"
          ],
          "default": "anchor",
          "description": "Well-known values: anchor means the duration before the anchor; purchase means the duration after purchase. Unknown values MUST be tolerated by readers and MUST NOT be evaluated without defined semantics."
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        }
      }
    },
    "seller_keeps": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": true,
      "description": "Open discriminated outcome. Known kinds are percentage, fixed_fee and unit_deduction. Readers MUST tolerate unknown kinds and preserve their fields.",
      "properties": {
        "kind": {
          "type": "string",
          "examples": [
            "percentage",
            "fixed_fee",
            "unit_deduction"
          ],
          "description": "Open discriminator. Unknown values MUST be tolerated."
        },
        "buyer_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "seller_keeps": {
          "$ref": "#/$defs/seller_keeps"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "percentage"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "buyer_bps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fixed_fee"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "seller_keeps"
            ],
            "properties": {
              "seller_keeps": {
                "required": [
                  "amount",
                  "currency"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unit_deduction"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "seller_keeps"
            ],
            "properties": {
              "seller_keeps": {
                "required": [
                  "quantity",
                  "unit"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
